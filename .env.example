NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Demo checkout is ALWAYS blocked with NODE_ENV=production.
ALLOW_DEMO_CHECKOUT=false
COD_ENABLED=true
# EasyKash Direct Payment (cards and installment providers).
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
# Used when the customer does not provide an email address.
EASYKASH_FALLBACK_EMAIL=orders@mansokar.com
# Optional anonymous, first-party usage counts; visitor consent is required.
ANALYTICS_ENABLED=false

# Optional owner bootstrap: only a verified email can receive its first admin grant.
ADMIN_BOOTSTRAP_EMAIL=

# Server-only bearer credential for daily temporary-data cleanup.
CRON_SECRET=

# Enable indexing only for the approved production cutover. Preview stays noindex.
STORE_LAUNCH_APPROVED=false

# Optional owner-provided Search Console verification token (not a URL).
GOOGLE_SITE_VERIFICATION=

# SEO domain cutover: enable only after DNS/TLS/preflight and owner approval.
SEO_DOMAIN_MIGRATION=false
# Enabled after the additive SEO content-date/analytics migration is applied.
SEO_CONTENT_TIMESTAMPS_ENABLED=false
# Search retrieval remains allowed; training crawler access requires owner opt-in.
SEO_ALLOW_TRAINING_CRAWLERS=false
# Optional GA4, loaded only after analytics consent. No purchase browser event is emitted.
NEXT_PUBLIC_GA4_ID=
# Merchant feed: authenticated, disabled until account/policies/shipping/stock are verified.
MERCHANT_FEED_ENABLED=false
MERCHANT_EG_ELIGIBILITY_CONFIRMED=false
MERCHANT_SHIPPING_CONFIGURED=false
MERCHANT_FEED_TOKEN=

# HTTP Basic username for Merchant Center scheduled fetch; token is the password.
MERCHANT_FEED_USERNAME=mopc-feed
