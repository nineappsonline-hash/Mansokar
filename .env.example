NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Demo checkout is ALWAYS blocked with NODE_ENV=production.
ALLOW_DEMO_CHECKOUT=false
COD_ENABLED=true
# EasyKash Direct Payment (cards and installment providers).
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
# Used when the customer does not provide an email address.
EASYKASH_FALLBACK_EMAIL=orders@mansokar.com
# Optional anonymous, first-party usage counts; visitor consent is required.
ANALYTICS_ENABLED=false

# Optional owner bootstrap: only a verified email can receive its first admin grant.
ADMIN_BOOTSTRAP_EMAIL=

# Server-only bearer credential for daily temporary-data cleanup.
CRON_SECRET=

# Enable indexing only for the approved production cutover. Preview stays noindex.
STORE_LAUNCH_APPROVED=false

# Optional owner-provided Search Console verification token (not a URL).
GOOGLE_SITE_VERIFICATION=
